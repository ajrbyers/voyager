{# avatar - circular initials block.
   Args:
     - initials: 1-3 letters
     - size:     '' (24px) | 'md' (32px) | 'lg' (48px)
     - kind:     '' (neutral) | 'purple' | 'orange' | 'green' | 'red' | 'teal' | 'pink'

   Usage:
     {{ avatar("AH", kind="purple") }}
     {{ avatar("MW", size="md", kind="orange") }}
#}
{% macro avatar(initials, size="", kind="") %}
{%- set classes = ['avatar'] -%}
{%- if size %}{% set classes = classes + ['avatar-' ~ size] %}{% endif -%}
{%- if kind %}{% set classes = classes + ['avatar-' ~ kind] %}{% endif -%}
<span class="{{ classes|join(' ')|e }}" aria-hidden="true">{{ initials|e }}</span>
{% endmacro %}
