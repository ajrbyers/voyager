{# filter-bar - control row with selects and active-chip summary.

   Compose with these macros:
     - filter_bar()        wrapper
     - filter_bar_controls(prefix_label="Filter:")
     - filter_select(id, label, options, value=None)
     - filter_bar_chips()
     - filter_chip(label, remove_url)
     - filter_clear(url)

   filter_bar takes two slots via {% call %}:
     1. Controls (selects, label)
     2. Chips section is rendered automatically below if chips macros
        are nested in a wrapper element with class filter-bar-chips.

   Usage:
     {% call filter_bar() %}
       {% call filter_bar_controls() %}
         {{ filter_select("stage", "Stage", options=[
             {"value": "all", "label": "All stages", "selected": True},
         ]) }}
       {% endcall %}
       {% call filter_bar_chips() %}
         {{ filter_chip("Peer Review", remove_url="?stage=all") }}
         {{ filter_clear("?") }}
       {% endcall %}
     {% endcall %}
#}

{% macro filter_bar(label="Filter articles") %}
<div class="filter-bar" role="search" aria-label="{{ label|e }}">
  {{ caller() }}
</div>
{% endmacro %}

{% macro filter_bar_controls(prefix_label="Filter:") %}
<div class="filter-bar-controls">
  <span class="filter-bar-label">{{ prefix_label|e }}</span>
  {{ caller() }}
</div>
{% endmacro %}

{# filter_select - compact select; options is a list of {value, label, selected?} #}
{% macro filter_select(id, label, options=[], value=None) %}
<label class="visually-hidden" for="{{ id|e }}">{{ label|e }}</label>
<select id="{{ id|e }}" name="{{ id|e }}" class="filter-select" aria-label="{{ label|e }}">
  {% for opt in options %}
    <option value="{{ opt.value|e }}"
      {% if (value is not none and opt.value|string == value|string) or opt.selected %}selected{% endif %}>
      {{ opt.label|e }}
    </option>
  {% endfor %}
</select>
{% endmacro %}

{% macro filter_bar_chips() %}
<div class="filter-bar-chips">{{ caller() }}</div>
{% endmacro %}

{% macro filter_chip(label, remove_url="#") %}
<span class="filter-chip">
  {{ label|e }}
  <a href="{{ remove_url|e }}" class="filter-chip-remove" aria-label="Remove {{ label|e }} filter">×</a>
</span>
{% endmacro %}

{% macro filter_clear(url="#") %}
<a href="{{ url|e }}" class="filter-bar-clear">Clear filters</a>
{% endmacro %}
