{# stat - single large number + label.
   Args:
     - number: integer or string
     - label:  text below the number
     - kind:   '' (default) | 'critical' | 'success' | 'warning'

   Usage:
     {{ stat(14, "In review", kind="critical") }}
#}
{% macro stat(number, label, kind="") %}
<div class="stat{% if kind %} stat-{{ kind|e }}{% endif %}">
  <span class="stat-number">{{ number|e }}</span>
  <span class="stat-label">{{ label|e }}</span>
</div>
{% endmacro %}
