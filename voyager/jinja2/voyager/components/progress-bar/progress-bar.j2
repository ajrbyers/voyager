{# progress-bar - thin top loading bar.
   Render once at the top of the page. Voyager ships no driver for it:
   the consuming application drives the width and the .is-running class
   (the docs page shows an HTMX integration example).

   Usage:
     {{ progress_bar() }}
#}
{% macro progress_bar(id="progress-bar") %}
<div id="{{ id|e }}" class="progress-bar" aria-hidden="true"></div>
{% endmacro %}
