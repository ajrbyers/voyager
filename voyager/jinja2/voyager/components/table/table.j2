{# table - data table.

   Compose with these macros:
     - table(bordered=True)        wrapper with thead / tbody slots via call
     - thead()                     header row wrapper
     - tr()                        body row wrapper
     - th(label, scope="col")      header cell (label is escaped)
     - td(content, right=False)    body cell (content is escaped)

   Cell content is escaped by default. Where a cell legitimately needs
   markup (links, tags, mono spans), use td as a {% call %} block - the
   block content is template-authored, not data:
     {% call td(right=True) %}<a href="#">Download</a>{% endcall %}

   Or for very simple tables, use the data-driven shortcut:
     - simple_table(headers, rows, bordered=True)   (all cells escaped)

   Usage (composable):
     {% call table() %}
       {% call thead() %}
         {{ th("File ID") }}{{ th("File name") }}{{ th("Uploaded") }}{{ th("Action") }}
       {% endcall %}
       {% call tr() %}
         {% call td() %}<span class="mono">8421</span>{% endcall %}
         {{ td("okafor_lstm_v2.docx") }}
         {{ td("2026-04-29 09:14") }}
         {% call td(right=True) %}<a href="#">Download</a>{% endcall %}
       {% endcall %}
     {% endcall %}
#}
{% macro table(bordered=True) %}
<table class="table{% if bordered %} table-bordered{% endif %}">
  {{ caller() }}
</table>
{% endmacro %}

{% macro thead() %}<thead><tr>{{ caller() }}</tr></thead>{% endmacro %}

{% macro tr() %}
{# tbody is implicit here; tables that mix multiple body groups should
   wrap them manually. #}
<tbody><tr>{{ caller() }}</tr></tbody>
{% endmacro %}

{% macro th(label, scope="col") %}<th scope="{{ scope|e }}">{{ label|e }}</th>{% endmacro %}

{% macro td(content="", right=False) %}
<td{% if right %} class="right"{% endif %}>{% if caller is defined %}{{ caller() }}{% else %}{{ content|e }}{% endif %}</td>
{% endmacro %}

{# Data-driven shortcut for simple cases. All cells are escaped; use the
   composable form with {% call td() %} when a cell needs markup. #}
{% macro simple_table(headers=[], rows=[], bordered=True) %}
<table class="table{% if bordered %} table-bordered{% endif %}">
  <thead>
    <tr>{% for h in headers %}<th scope="col">{{ h|e }}</th>{% endfor %}</tr>
  </thead>
  <tbody>
    {% for row in rows %}
      <tr>{% for cell in row %}<td>{{ cell|e }}</td>{% endfor %}</tr>
    {% endfor %}
  </tbody>
</table>
{% endmacro %}
