{# app-footer - slim page footer with version and help link.
   Args:
     - version:  display version string
     - help_url: target of the help link

   Usage:
     {{ app_footer(version="v1.7", help_url="/help") }}
#}
{% macro app_footer(version="v1.7", help_url="#") %}
<footer class="app-footer">
  <span>Janeway · {{ version|e }}</span>
  <a href="{{ help_url|e }}">Help &amp; documentation</a>
</footer>
{% endmacro %}
