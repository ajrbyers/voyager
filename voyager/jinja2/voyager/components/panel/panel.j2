{# panel - large confirmation panel at the top of a completion page.
   Args:
     - title: large headline (h1)
     - kind:  '' (default green) | 'warning' | 'error' | 'info'
   Body content via {% call %}.

   Usage:
     {% call panel("Decision sent") %}
       Decision reference<br><strong>DEC-2026-091</strong>
     {% endcall %}
#}
{% macro panel(title, kind="") %}
<div class="panel{% if kind %} panel-{{ kind|e }}{% endif %}">
  <h1 class="panel-title">{{ title|e }}</h1>
  <div class="panel-body">
    {{ caller() }}
  </div>
</div>
{% endmacro %}
