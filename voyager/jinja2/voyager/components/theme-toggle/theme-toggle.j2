{# theme-toggle - light/dark mode switch.

   Renders a button that toggles `data-theme` on <html>. The state is
   persisted in localStorage and read on page load.

   theme_init() renders the FOUC-prevention snippet: it sets the saved
   (or OS-preferred) theme on <html> before first paint. Render it
   inline in <head> — it must run synchronously, so it cannot live in
   the deferred index.js module bundle.

   Usage:
     <head>
       …
       {{ theme_init() }}
     </head>
     …
     {{ theme_toggle() }}
#}

{% macro theme_init() %}
<script>
(function () {
  // Set the saved theme before paint so we don't flash light content.
  var k = 'voyager-theme';
  var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  var theme = localStorage.getItem(k) || (prefersDark ? 'dark' : 'light');
  document.documentElement.setAttribute('data-theme', theme);
})();
</script>
{% endmacro %}
{% macro theme_toggle(label="Dark") %}
<button type="button" class="theme-toggle" data-theme-toggle
        aria-label="Toggle dark mode" aria-pressed="false">
  <svg class="icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
  <svg class="icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>
  <span data-theme-label>{{ label|e }}</span>
</button>
{% endmacro %}
