{# sidebar-nav - left rail.
   Compose with three macros:
     - sidebar_nav()          wrapper, contains the journal block + sections
     - sidebar_nav_section()  one named group of links
     - sidebar_nav_item()     one link

   Below 900px the link sections collapse behind a Menu button (the
   journal identity row stays visible). The button uses the shared
   nav disclosure driver: data-disclosure-toggle + aria-controls.
   Pass a unique `id` when more than one sidebar-nav renders on a page.

   Usage:
     {% call sidebar_nav(journal={"mark":"JE","name":"Journal of Energy Modelling","sub":"Editor view"}) %}
       {% call sidebar_nav_section("Workflow") %}
         {{ sidebar_nav_item("Unassigned",  url="/unassigned", count=7) }}
         {{ sidebar_nav_item("Peer review", url="/review",      count=14, current=True) }}
       {% endcall %}
     {% endcall %}
#}

{% macro sidebar_nav(journal=None, label="Editorial navigation", id="sidebar-nav-content") %}
<nav class="sidebar-nav" aria-label="{{ label|e }}">
  <div class="sidebar-nav-journal">
    {% if journal %}
    <span class="sidebar-nav-mark" aria-hidden="true">{{ journal.mark|e }}</span>
    <div>
      <div class="sidebar-nav-name">{{ journal.name|e }}</div>
      {% if journal.sub %}<div class="sidebar-nav-sub">{{ journal.sub|e }}</div>{% endif %}
    </div>
    {% endif %}
    <button type="button" class="sidebar-nav-toggle" data-disclosure-toggle
            aria-expanded="false" aria-controls="{{ id|e }}">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      Menu
    </button>
  </div>
  <div class="sidebar-nav-content" id="{{ id|e }}">
    {{ caller() }}
  </div>
</nav>
{% endmacro %}

{% macro sidebar_nav_section(label) %}
<h2 class="sidebar-nav-section">{{ label|e }}</h2>
<ul>{{ caller() }}</ul>
{% endmacro %}

{% macro sidebar_nav_item(label, url="#", count=None, current=False) %}
<li>
  <a href="{{ url|e }}"
     class="sidebar-nav-link"
     {% if current %}aria-current="page"{% endif %}>
    {{ label|e }}
    {% if count is not none %}
      <span class="sidebar-nav-count" aria-label="{{ count|e }} articles">{{ count|e }}</span>
    {% endif %}
  </a>
</li>
{% endmacro %}
