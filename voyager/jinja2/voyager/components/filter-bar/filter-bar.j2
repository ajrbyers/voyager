{# filter-bar - control row with selects and active-chip summary.

   Compose with these macros:
     - filter_bar()        wrapper
     - filter_bar_controls(prefix_label="Filter:")
     - filter_select(id, label, options, value=None)
     - filter_input(id, label, type="text", value=None)
     - filter_bar_chips()
     - filter_chip(label, remove_url)
     - filter_clear(url)

   filter_bar takes two slots via {% call %}:
     1. Controls (selects, label)
     2. Chips section is rendered automatically below if chips macros
        are nested in a wrapper element with class filter-bar-chips.

   Usage:
     {% call filter_bar() %}
       {% call filter_bar_controls() %}
         {{ filter_select("stage", "Stage", options=[
             {"value": "all", "label": "All stages", "selected": True},
         ]) }}
       {% endcall %}
       {% call filter_bar_chips() %}
         {{ filter_chip("Peer Review", remove_url="?stage=all") }}
         {{ filter_clear("?") }}
       {% endcall %}
     {% endcall %}
#}

{% macro filter_bar(label="Filter articles") %}
<div class="filter-bar" role="search" aria-label="{{ label|e }}">
  {{ caller() }}
</div>
{% endmacro %}

{% macro filter_bar_controls(prefix_label="Filter:") %}
<div class="filter-bar-controls">
  <span class="filter-bar-label">{{ prefix_label|e }}</span>
  {{ caller() }}
</div>
{% endmacro %}

{# filter_select - compact select; options is a list of {value, label, selected?}.
   name defaults to id; attrs is an optional dict (hx-*, data-*) via xmlattr. #}
{% macro filter_select(id, label, options=[], value=None, name=None, attrs=None) %}
<label class="visually-hidden" for="{{ id|e }}">{{ label|e }}</label>
<select id="{{ id|e }}" name="{{ (name or id)|e }}" class="filter-select" aria-label="{{ label|e }}"{% if attrs %}{{ attrs|xmlattr }}{% endif %}>
  {% for opt in options %}
    <option value="{{ opt.value|e }}"
      {% if (value is not none and opt.value|string == value|string) or opt.selected %}selected{% endif %}>
      {{ opt.label|e }}
    </option>
  {% endfor %}
</select>
{% endmacro %}

{# filter_input - compact input (text, date, number, …) sized to match
   filter_select so the two can share a row. name defaults to id; attrs is
   an optional dict (hx-*, data-*) via xmlattr. #}
{% macro filter_input(id, label, type="text", value=None, name=None, attrs=None) %}
<label class="visually-hidden" for="{{ id|e }}">{{ label|e }}</label>
<input id="{{ id|e }}" name="{{ (name or id)|e }}" type="{{ type|e }}" class="filter-input" aria-label="{{ label|e }}"{% if value is not none %} value="{{ value|e }}"{% endif %}{% if attrs %}{{ attrs|xmlattr }}{% endif %}>
{% endmacro %}

{% macro filter_bar_chips() %}
<div class="filter-bar-chips">{{ caller() }}</div>
{% endmacro %}

{# remove_attrs / attrs are optional dicts (hx-*, data-*) via xmlattr. #}
{% macro filter_chip(label, remove_url="#", remove_label=None, remove_attrs=None) %}
<span class="filter-chip">
  {{ label|e }}
  <a href="{{ remove_url|e }}" class="filter-chip-remove" aria-label="{{ (remove_label or 'Remove ' ~ label ~ ' filter')|e }}"{% if remove_attrs %}{{ remove_attrs|xmlattr }}{% endif %}>×</a>
</span>
{% endmacro %}

{% macro filter_clear(url="#", attrs=None) %}
<a href="{{ url|e }}" class="filter-bar-clear"{% if attrs %}{{ attrs|xmlattr }}{% endif %}>Clear filters</a>
{% endmacro %}
